# Clé générée sur https://developer.brawlstars.com
# IMPORTANT : quand tu la crées, whiteliste l'IP du proxy RoyaleAPI
# (45.79.218.79) et PAS ton IP perso — voir le README.
BRAWL_STARS_API_KEY=

# Tags des clubs affichés (séparés par une virgule)
CLUB_TAGS=#80CLJG9LQ,#2QJ0Q29CL,#2Q29PJVYL

# Secret partagé avec le cron Vercel pour sécuriser /api/cron/snapshot
CRON_SECRET=change-moi

# Injectées automatiquement par l'intégration Redis de Vercel (Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Connexion Discord (Discord Developer Portal → OAuth2 → General)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Secret aléatoire utilisé par NextAuth pour signer les sessions.
# Génère-en un avec : openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://purple-corp-website.vercel.app

# ID(s) Discord autorisés à publier une actualité sur /actualites (virgule
# si plusieurs). Active le mode développeur Discord (Réglages > Avancés),
# puis clic droit sur ton profil > "Copier l'ID utilisateur".
ADMIN_DISCORD_IDS=
